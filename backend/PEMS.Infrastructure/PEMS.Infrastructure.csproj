<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="HtmlSanitizer" Version="9.0.892" />
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0" />
		<PackageReference Include="Resend" Version="0.8.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\PEMS.Domain\PEMS.Domain.csproj" />
		<ProjectReference Include="..\PEMS.Application\PEMS.Application.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!--
			The transport-parity tests compare the Resend request body against the .eml the SMTP path
			writes. Both are internal details of how a transport talks to its provider, and two
			transports quietly disagreeing is exactly what those tests exist to catch — so the payload
			builder is reachable from the test assembly rather than promoted to public API.
		-->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>PEMS.IntegrationTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
</Project>