        "ASPNETCORE_ENVIRONMENT": "Development",
        "PerCampusFormV2__Enabled": "true",
        "PerCampusFormV2Write__Enabled": "true"
      }
    },
    "http-v1-legacy": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5265",
      "environmentVariables": {
