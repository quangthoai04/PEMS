# ── PEMS React frontend env ──────────────────────────────────────────────
# API base URL (backend)
VITE_API_BASE_URL=http://localhost:5265/api

# Auth mode: DevMixed (password + SSO) | ProductionSsoOnly (SSO/FEID only)
VITE_AUTH_MODE=DevMixed
VITE_ENABLE_PASSWORD_LOGIN=true
VITE_ENABLE_GOOGLE_SSO=true
VITE_ENABLE_FEID=false

# Google Sign-In client id. If empty, the Google button stays clickable but shows a
# "chưa cấu hình Client ID" error (it is not silently disabled).
VITE_GOOGLE_CLIENT_ID=

# ── Production example ───────────────────────────────────────────────────
# VITE_AUTH_MODE=ProductionSsoOnly
# VITE_ENABLE_PASSWORD_LOGIN=false
# VITE_ENABLE_GOOGLE_SSO=true
# VITE_ENABLE_FEID=true
