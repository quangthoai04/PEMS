using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;

namespace Scaffolder
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Starting Scaffold...");
            
            string rootDir = Directory.GetCurrentDirectory();
            string backendAppDir = Path.Combine(rootDir, "backend", "PEMS.Application");
            string backendApiDir = Path.Combine(rootDir, "backend", "PEMS.Api", "Controllers");
            string testsAppDir = Path.Combine(rootDir, "tests", "PEMS.ApplicationTests");
            string docsArchitectureDir = Path.Combine(rootDir, "docs", "architecture");
            string docsApiDir = Path.Combine(rootDir, "docs", "api");

            // Clean up old Management folders
            var oldDirs = new[] { "AccountManagement", "CampusManagement", "DepartmentManagement", "EmailManagement", "FaqManagement", "GalleryManagement", "NewsManagement", "RolePermissionManagement", "ApiManagement" };
            foreach (var dir in oldDirs)
            {
                var p = Path.Combine(backendAppDir, dir);
                if (Directory.Exists(p)) Directory.Delete(p, true);
            }

            var ucListFile = Path.Combine(rootDir, "docs", "use-cases", "USE_CASE_LIST.md");
            var lines = File.ReadAllLines(ucListFile);

            var useCases = new List<UseCase>();

            foreach (var line in lines)
            {
                if (line.StartsWith("| UC-"))
                {
                    var parts = line.Split('|', StringSplitOptions.RemoveEmptyEntries);
                    if (parts.Length >= 2)
                    {
                        var uc = new UseCase
                        {
                            Code = parts[0].Trim(),
                            Name = parts[1].Trim()
                        };
                        uc.SetProperties();
                        useCases.Add(uc);
                    }
                }
            }

            // Generate BACKEND_USE_CASE_CLASS_BLUEPRINT.md
            var blueprintSb = new System.Text.StringBuilder();
            blueprintSb.AppendLine("# Backend Use Case Class Blueprint");
            blueprintSb.AppendLine();
            blueprintSb.AppendLine("| UC Code | UC Name | Module | Type | API Controller | Application Class | Domain Entity | Infrastructure Needed | Permission | Status |");
            blueprintSb.AppendLine("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |");

            foreach (var uc in useCases)
            {
                blueprintSb.AppendLine($"| {uc.Code} | {uc.Name} | {uc.Module} | {uc.Type} | {uc.Module}Controller | {uc.ClassName} | {uc.Entity} | {uc.Infra} | {uc.Permission} | Scaffolded |");
                
                // Scaffold Application Layer
                var moduleDir = Path.Combine(backendAppDir, uc.Module);
                var typeDir = Path.Combine(moduleDir, uc.Type == "Command" ? "Commands" : "Queries", uc.ClassName.Replace("Command", "").Replace("Query", ""));
                Directory.CreateDirectory(typeDir);

                if (uc.Type == "Command")
                {
                    File.WriteAllText(Path.Combine(typeDir, $"{uc.ClassName}.cs"), $"using MediatR;\n\nnamespace PEMS.Application.{uc.Module}.Commands.{uc.ClassName.Replace("Command", "")};\n\npublic class {uc.ClassName} : IRequest<{uc.ClassName.Replace("Command", "")}Response>\n{{\n}}");
                    File.WriteAllText(Path.Combine(typeDir, $"{uc.ClassName}Handler.cs"), $"using System;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing MediatR;\n\nnamespace PEMS.Application.{uc.Module}.Commands.{uc.ClassName.Replace("Command", "")};\n\npublic sealed class {uc.ClassName}Handler : IRequestHandler<{uc.ClassName}, {uc.ClassName.Replace("Command", "")}Response>\n{{\n    public Task<{uc.ClassName.Replace("Command", "")}Response> Handle({uc.ClassName} request, CancellationToken cancellationToken)\n    {{\n        throw new NotImplementedException(\"UC {uc.Name} has been scaffolded. Business rules must be implemented after UC specification is completed.\");\n    }}\n}}");
                    File.WriteAllText(Path.Combine(typeDir, $"{uc.ClassName}Validator.cs"), $"using FluentValidation;\n\nnamespace PEMS.Application.{uc.Module}.Commands.{uc.ClassName.Replace("Command", "")};\n\npublic sealed class {uc.ClassName}Validator : AbstractValidator<{uc.ClassName}>\n{{\n    public {uc.ClassName}Validator()\n    {{\n        // TODO: Add validation rules after UC specification is completed.\n    }}\n}}");
                    File.WriteAllText(Path.Combine(typeDir, $"{uc.ClassName.Replace("Command", "")}Response.cs"), $"using System;\n\nnamespace PEMS.Application.{uc.Module}.Commands.{uc.ClassName.Replace("Command", "")};\n\npublic sealed class {uc.ClassName.Replace("Command", "")}Response\n{{\n    public Guid? Id {{ get; init; }}\n    public string Status {{ get; init; }} = \"Scaffolded\";\n    public string Message {{ get; init; }} = \"Use case scaffolded. Business logic is not implemented yet.\";\n}}");
                }
                else
                {
                    File.WriteAllText(Path.Combine(typeDir, $"{uc.ClassName}.cs"), $"using MediatR;\n\nnamespace PEMS.Application.{uc.Module}.Queries.{uc.ClassName.Replace("Query", "")};\n\npublic class {uc.ClassName} : IRequest<{uc.ClassName.Replace("Query", "")}Dto>\n{{\n}}");
                    File.WriteAllText(Path.Combine(typeDir, $"{uc.ClassName}Handler.cs"), $"using System;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing MediatR;\n\nnamespace PEMS.Application.{uc.Module}.Queries.{uc.ClassName.Replace("Query", "")};\n\npublic sealed class {uc.ClassName}Handler : IRequestHandler<{uc.ClassName}, {uc.ClassName.Replace("Query", "")}Dto>\n{{\n    public Task<{uc.ClassName.Replace("Query", "")}Dto> Handle({uc.ClassName} request, CancellationToken cancellationToken)\n    {{\n        throw new NotImplementedException(\"UC {uc.Name} has been scaffolded. Business rules must be implemented after UC specification is completed.\");\n    }}\n}}");
                    File.WriteAllText(Path.Combine(typeDir, $"{uc.ClassName.Replace("Query", "")}Dto.cs"), $"using System;\n\nnamespace PEMS.Application.{uc.Module}.Queries.{uc.ClassName.Replace("Query", "")};\n\npublic sealed class {uc.ClassName.Replace("Query", "")}Dto\n{{\n    public Guid? Id {{ get; init; }}\n    public string Status {{ get; init; }} = \"Scaffolded\";\n    public string Message {{ get; init; }} = \"Use case scaffolded. Business logic is not implemented yet.\";\n}}");
                }

                // Scaffold Tests
                var testModuleDir = Path.Combine(testsAppDir, uc.Module);
                Directory.CreateDirectory(testModuleDir);
                File.WriteAllText(Path.Combine(testModuleDir, $"{uc.ClassName}Tests.cs"), $"using System.Threading.Tasks;\nusing Xunit;\n\nnamespace PEMS.ApplicationTests.{uc.Module};\n\npublic class {uc.ClassName}Tests\n{{\n    [Fact(Skip = \"Pending UC specification\")]\n    public async Task Handle_Should_Process_{uc.ClassName}()\n    {{\n        // TODO: Implement after UC specification is completed.\n    }}\n}}");
            }
            
            Directory.CreateDirectory(docsArchitectureDir);
            File.WriteAllText(Path.Combine(docsArchitectureDir, "BACKEND_USE_CASE_CLASS_BLUEPRINT.md"), blueprintSb.ToString());

            // Scaffold API Controllers
            var modules = useCases.Select(u => u.Module).Distinct().ToList();
            foreach (var module in modules)
            {
                var controllerPath = Path.Combine(backendApiDir, $"{module}Controller.cs");
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("using MediatR;");
                sb.AppendLine("using Microsoft.AspNetCore.Mvc;");
                sb.AppendLine("using System.Threading;");
                sb.AppendLine("using System.Threading.Tasks;");
                sb.AppendLine();
                sb.AppendLine($"namespace PEMS.Api.Controllers");
                sb.AppendLine("{");
                sb.AppendLine($"    [ApiController]");
                sb.AppendLine($"    [Route(\"api/[controller]\")]");
                sb.AppendLine($"    public class {module}Controller : ControllerBase");
                sb.AppendLine("    {");
                sb.AppendLine("        private readonly IMediator _mediator;");
                sb.AppendLine($"        public {module}Controller(IMediator mediator) => _mediator = mediator;");
                sb.AppendLine();
                
                foreach (var uc in useCases.Where(u => u.Module == module))
                {
                    var httpMethod = uc.Type == "Command" ? "HttpPost" : "HttpGet";
                    var actionName = uc.ClassName.Replace("Command", "").Replace("Query", "");
                    var param = uc.Type == "Command" ? $"[FromBody] PEMS.Application.{module}.Commands.{actionName}.{uc.ClassName} command" : $"[FromQuery] PEMS.Application.{module}.Queries.{actionName}.{uc.ClassName} query";
                    var req = uc.Type == "Command" ? "command" : "query";
                    
                    sb.AppendLine($"        [{httpMethod}(\"{actionName.ToLower()}\")]");
                    sb.AppendLine($"        public async Task<IActionResult> {actionName}({param}, CancellationToken cancellationToken)");
                    sb.AppendLine("        {");
                    sb.AppendLine($"            var result = await _mediator.Send({req}, cancellationToken);");
                    sb.AppendLine("            return Ok(result);");
                    sb.AppendLine("        }");
                    sb.AppendLine();
                }
                
                sb.AppendLine("    }");
                sb.AppendLine("}");
                File.WriteAllText(controllerPath, sb.ToString());
            }

            Console.WriteLine("Done scaffolding.");
        }
    }

    class UseCase
    {
        public string Code { get; set; }
        public string Name { get; set; }
        public string Module { get; set; }
        public string Type { get; set; }
        public string ClassName { get; set; }
        public string Entity { get; set; }
        public string Infra { get; set; }
        public string Permission { get; set; }

        public void SetProperties()
        {
            int ucNum = int.Parse(Code.Split('-')[1]);
            
            if (ucNum >= 1 && ucNum <= 9) Module = "PublicContent";
            else if (ucNum >= 10 && ucNum <= 13) Module = "Authentication";
            else if (ucNum >= 14 && ucNum <= 16) Module = "Profiles";
            else if (ucNum >= 17 && ucNum <= 41) Module = "Delegations";
            else if (ucNum >= 42 && ucNum <= 49) Module = "Emails";
            else if (ucNum >= 50 && ucNum <= 54) Module = "Partners";
            else if (ucNum >= 55 && ucNum <= 56) Module = "Documents";
            else if (ucNum >= 57 && ucNum <= 61) Module = "Galleries";
            else if (ucNum >= 62 && ucNum <= 63) Module = "MeetingMinutes";
            else if (ucNum >= 64 && ucNum <= 68) Module = "Faqs";
            else if (ucNum >= 69 && ucNum <= 71) Module = "Reports";
            else if (ucNum >= 72 && ucNum <= 78) Module = "Calendars";
            else if (ucNum >= 79 && ucNum <= 80) Module = "Feedbacks";
            else if (ucNum >= 81 && ucNum <= 87) Module = "Campuses";
            else if (ucNum >= 88 && ucNum <= 94) Module = "News";
            else if (ucNum >= 95 && ucNum <= 100) Module = "Accounts";
            else if (ucNum >= 101 && ucNum <= 116) Module = "Departments";
            else if (ucNum >= 117 && ucNum <= 121) Module = "Roles";
            else if (ucNum >= 122 && ucNum <= 130) Module = "ApiIntegrations";
            else if (ucNum >= 131 && ucNum <= 135) Module = "AgendaTemplates";
            else Module = "Common";

            bool isQuery = Name.StartsWith("View") || Name.StartsWith("Search") || Name.StartsWith("Filter");
            Type = isQuery ? "Query" : "Command";
            
            string cleanName = Name.Replace(" ", "").Replace("/", "And").Replace("-", "").Replace("&", "And");
            ClassName = cleanName + Type;
            
            Entity = "TBD - Need UC specification";
            Infra = "DB";
            Permission = "TBD";
        }
    }
}
