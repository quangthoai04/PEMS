# ==============================================================================
# .gitignore Tổng Hợp Toàn Diện Cho Dự Án Fullstack (ASP.NET Core & React/Vite)
# ==============================================================================

# Visual Studio / IDE
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/
.vscode/

# .NET build output
bin/
obj/
**/bin/
**/obj/
[An]ative/
x64/
x86/
ubuntu.*/
debian.*/
centos.*/
*.pdb
*.dll
*.exe
*.ini

# Frontend dependencies/build
node_modules/
jspm_packages/
dist/
build/
out/
coverage/

# Logs/temp
*.log
logs/
temp/
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment/secrets
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
*.Secrets.json
[Ee]nv.json

## Thư mục sinh ra bởi công cụ kiểm thử (Test Results)
[Tt]est[Rr]esult*/

## Thư mục lưu cache hệ thống của các thư viện Frontend
.eslintcache
.stylelintcache
.prettiercache
.cache/
.turbo/

